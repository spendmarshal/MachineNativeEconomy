{
  "name": "@spendmarshal/cli",
  "version": "0.0.2",
  "license": "Apache-2.0",
  "author": "SpendMarshal <hello@spendmarshal.com>",
  "description": "Operator CLI for the Agentic Payment Gateway: export-evidence, verify (offline), statement (a client's month-end statement from its evidence bundle), policy lint, audit-logs (read-only LiteLLM spend-log diagnostic)",
  "keywords": [
    "agentic payments",
    "evidence",
    "receipts",
    "cli"
  ],
  "homepage": "https://github.com/spendmarshal/MachineNativeEconomy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spendmarshal/MachineNativeEconomy.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/spendmarshal/MachineNativeEconomy/issues"
  },
  "engines": {
    "node": ">=20.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "spendmarshal": "./bin/spendmarshal.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@spendmarshal/core": "workspace:*",
    "viem": "^2.21.54",
    "yaml": "^2.6.1"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ]
}
