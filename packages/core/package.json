{
  "name": "@spendmarshal/core",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "author": "SpendMarshal <hello@spendmarshal.com>",
  "description": "Canonical types for the Agentic Payment Gateway: PaymentIntent, attenuable credentials, policy evaluation, signed receipts, evidence bundles, rail wire formats",
  "keywords": [
    "agentic payments",
    "x402",
    "mpp",
    "l402",
    "policy",
    "receipts",
    "ai agents"
  ],
  "homepage": "https://github.com/spendmarshal/MachineNativeEconomy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spendmarshal/MachineNativeEconomy.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/spendmarshal/MachineNativeEconomy/issues"
  },
  "engines": {
    "node": ">=20.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^1.9.1",
    "viem": "^2.21.54",
    "zod": "^3.24.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "fast-check": "^3.23.1"
  }
}
